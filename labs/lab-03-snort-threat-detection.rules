# ==============================================================================
# Production Snort Threat Detection Ruleset
# Solar-Powered Cyber & Cisco Networking Academy — Northeast Nigeria
# Operating Entity: ESSCO TECH AGENCY LTD (RC: 7192842)
# Lab Reference: Module 02 - Defensive Cybersecurity & Intrusion Analysis
# Standard: Snort 2.9 / 3.0 Compatible Signature Base
# ==============================================================================

# RULE 1: Nmap TCP SYN Stealth Port Scan Detection (MITRE ATT&CK T1046)
# Detects rapid TCP SYN frames initiated without payload and small window size
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"DEFENSE-NIDS: Inbound Nmap TCP SYN Reconnaissance Scan Detected"; flags:S,12; window:1024; threshold:type both, track by_src, count 15, seconds 5; classtype:attempted-recon; sid:1000001; rev:1;)

# RULE 2: SSH Authentication Brute-Force Rate Exceeded (MITRE ATT&CK T1110.001)
# Detects repeated TCP handshakes and SSH banner exchanges exceeding legitimate rates
alert tcp $EXTERNAL_NET any -> $HOME_NET 22 (msg:"DEFENSE-NIDS: SSH Brute-Force Authentication Spike Detected"; flow:to_server,established; content:"SSH-"; depth:4; threshold:type both, track by_src, count 6, seconds 30; classtype:attempted-admin; sid:1000002; rev:1;)

# RULE 3: Cisco IOS Privilege Escalation / Enable Brute-Force Attempt (MITRE ATT&CK T1078)
# Detects unauthorized attempts over cleartext administrative management sessions
alert tcp $EXTERNAL_NET any -> $HOME_NET 23 (msg:"DEFENSE-NIDS: Cisco IOS Cleartext Telnet Access / Enable Attempt"; flow:to_server,established; content:"enable"; nocase; classtype:bad-unknown; sid:1000003; rev:1;)

# RULE 4: Unauthorized SNMP Community String Brute Force (MITRE ATT&CK T1046 / T1087)
# Detects queries probing for default 'public' or 'private' SNMPv1/v2c strings
alert udp $EXTERNAL_NET any -> $HOME_NET 161 (msg:"DEFENSE-NIDS: Unauthorized SNMP Default Community String Query (public/private)"; content:"public"; nocase; threshold:type both, track by_src, count 3, seconds 10; classtype:attempted-recon; sid:1000004; rev:1;)

# RULE 5: Malicious Gratuitous ARP Cache Poisoning Signature (MITRE ATT&CK T1557.002)
# Identifies anomalous broadcast ARP replies characteristic of Ettercap/Arpspoof
alert ip $EXTERNAL_NET any -> $HOME_NET any (msg:"DEFENSE-NIDS: Suspected ARP Spoofing / Duplicate MAC Anomaly"; ip_proto:2054; threshold:type both, track by_src, count 10, seconds 2; classtype:bad-unknown; sid:1000005; rev:1;)

# RULE 6: DNS Tunneling & High-Entropy Data Exfiltration (MITRE ATT&CK T1071.004)
# Detects excessively long DNS query labels frequently associated with Iodine/DNScat2
alert udp $HOME_NET any -> $EXTERNAL_NET 53 (msg:"DEFENSE-NIDS: High-Entropy Suspicious DNS TXT Tunneling Query"; content:"|00 10 00 01|"; isdataat:60,relative; threshold:type limit, track by_src, count 5, seconds 20; classtype:policy-violation; sid:1000006; rev:1;)

# RULE 7: GNU Bash Shellshock Environment Variable Exploit (CVE-2014-6271 - MITRE ATT&CK T1059)
# Detects malicious trailing function definitions sent in HTTP headers (User-Agent, Referer)
alert tcp $EXTERNAL_NET any -> $HOME_NET 80 (msg:"DEFENSE-NIDS: GNU Bash Shellshock CVE-2014-6271 Injection Attempt"; flow:to_server,established; content:"() {"; classtype:attempted-admin; sid:1000007; rev:1;)

# RULE 8: Mirai / IoT Botnet Outbound Telnet C2 Telemetry (MITRE ATT&CK T1584)
# Detects outbound brute-force attempts characteristic of Mirai botnet scanner routines
alert tcp $HOME_NET any -> $EXTERNAL_NET 2323 (msg:"DEFENSE-NIDS: Outbound Mirai IoT Botnet Propagation Telemetry"; flow:to_server,established; content:"/bin/busybox"; classtype:trojan-activity; sid:1000008; rev:1;)

# RULE 9: Remote Command Execution (RCE) Unix Sh/Bash Spawn (MITRE ATT&CK T1059.004)
# Detects direct invocations of Unix command interpreters inside web server requests
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (msg:"DEFENSE-NIDS: HTTP Command Injection Payload (/bin/sh or /bin/bash)"; flow:to_server,established; content:"/bin/"; pcre:"/\/bin\/(sh|bash|dash|zsh)/i"; classtype:web-application-attack; sid:1000009; rev:1;)

# RULE 10: Outbound Interactive Reverse Shell Connection (MITRE ATT&CK T1059 / T1071)
# Detects interactive Unix shell banners transmitted outbound on non-standard ports
alert tcp $HOME_NET 1024: -> $EXTERNAL_NET 1024: (msg:"DEFENSE-NIDS: Outbound Interactive Unix Reverse Shell Detected"; flow:from_server,established; content:"$ "; depth:2; classtype:trojan-activity; sid:1000010; rev:1;)
